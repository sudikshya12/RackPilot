# Copy to .env and edit. Never commit .env.
# --- core ---
# RACKOPS_DATABASE_URL=sqlite:////absolute/path/rackops.db
RACKOPS_BIND_HOST=127.0.0.1
RACKOPS_FRONTEND_ORIGIN=http://localhost:5173
RACKOPS_SIM_PROBE_INTERVAL_SECONDS=3
# Read-only public preview: disables every mutation and collection endpoint.
RACKOPS_PUBLIC_PREVIEW=false
# --- optional live lab (lab-owned process on 127.0.0.1) ---
RACKOPS_LIVELAB_PORT=18081
# --- optional Redfish (read-only GETs). Empty URL = fixture mode. ---
RACKOPS_REDFISH_URL=
RACKOPS_REDFISH_USERNAME=
RACKOPS_REDFISH_PASSWORD=
RACKOPS_REDFISH_VERIFY_TLS=true
# --- optional integrations (disabled/unconfigured by default) ---
RACKOPS_ALERTMANAGER_WEBHOOK_ENABLED=false
RACKOPS_ALERTMANAGER_WEBHOOK_TOKEN=
RACKOPS_NETBOX_URL=
RACKOPS_NETBOX_TOKEN=
RACKOPS_JIRA_URL=
RACKOPS_JIRA_TOKEN=
RACKOPS_NOTIFICATIONS_ENABLED=false
